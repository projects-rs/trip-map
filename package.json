{
  "name": "trip-map",
  "version": "0.1.0",
  "private": true,
  "description": "Tools for building and testing the Trip Map app.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && eslint . && node tools/build-site.ts",
    "serve": "node tools/serve-site.ts",
    "test": "npm run build && playwright test",
    "check-tests": "node tools/check-tests.ts",
    "check-version": "node tools/check-version.ts"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.12",
    "eslint": "10.1.0",
    "leaflet": "1.9.4",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
